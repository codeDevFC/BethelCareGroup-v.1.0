import { NextAuthOptions } from "next-auth";
import CredentialsProvider from "next-auth/providers/credentials";

export const authOptions: NextAuthOptions = {
  providers: [
    CredentialsProvider({
      name: "Credentials",
      credentials: {
        username: { label: "Username", type: "text" },
        password: { label: "Password", type: "password" }
      },
      async authorize(credentials) {
        if (!credentials?.username || !credentials?.password) {
          return null;
        }

        // Simple admin check
        if (credentials.username === "admin" && 
            credentials.password === "BETHEL@UK777") {
          return {
            id: "admin",
            name: "Church Administrator",
            email: "admin@bethelwillenhall.org",
            role: "ADMIN",
          };
        }

        // Demo pastor login
        if (credentials.username === "pastor" && 
            credentials.password === "pastor@BWcg777") {
          return {
            id: "pastor1",
            name: "Pastor John Smith",
            email: "pastor@bethelwillenhall.org",
            role: "PASTOR",
          };
        }

        // Demo leader login
        if (credentials.username === "victory" && 
            credentials.password === "victory@BWcg03") {
          return {
            id: "leader1",
            name: "Group Leader",
            email: "leader@victory.org",
            role: "LEADER",
            groupId: "group1",
          };
        }

        // Demo member login
        if (credentials.username === "johnbcg" && 
            credentials.password === "johnbcg") {
          return {
            id: "member1",
            name: "John Member",
            email: "john@member.org",
            role: "MEMBER",
            groupId: "group1",
          };
        }

        return null;
      }
    })
  ],
  callbacks: {
    async jwt({ token, user }) {
      if (user) {
        token.role = user.role;
        token.groupId = user.groupId;
      }
      return token;
    },
    async session({ session, token }) {
      if (session?.user) {
        session.user.role = token.role as string;
        session.user.groupId = token.groupId as string;
      }
      return session;
    }
  },
  pages: {
    signIn: "/login",
    error: "/login",
  },
  session: {
    strategy: "jwt",
    maxAge: 30 * 24 * 60 * 60,
  },
  secret: process.env.NEXTAUTH_SECRET || "your-secret-key-change-this-in-production",
  debug: true,
};
